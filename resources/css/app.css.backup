@import 'tailwindcss';

@source '../../vendor/laravel/framework/src/Illuminate/Pagination/resources/views/*.blade.php';
@source '../../storage/framework/views/*.php';
@source '../../resources/views/**/*.blade.php';

@theme {
    --font-sans: 'Instrument Sans', ui-sans-serif, system-ui, sans-serif, 'Apple Color Emoji', 'Segoe UI Emoji',
        'Segoe UI Symbol', 'Noto Color Emoji';

    --color-brand-50: oklch(0.97 0.014 18);
    --color-brand-100: oklch(0.94 0.03 18);
    --color-brand-200: oklch(0.88 0.07 18);
    --color-brand-300: oklch(0.79 0.13 18);
    --color-brand-400: oklch(0.68 0.2 18);
    --color-brand-500: oklch(0.58 0.24 18);
    --color-brand-600: oklch(0.51 0.24 18);
    --color-brand-700: oklch(0.45 0.21 18);
    --color-brand-800: oklch(0.39 0.17 18);
    --color-brand-900: oklch(0.34 0.14 18);
    --color-brand-950: oklch(0.22 0.08 18);

    --color-canvas: oklch(0.985 0.004 25);
    --color-surface: oklch(1 0 0);
    --color-ink: oklch(0.22 0.02 280);
    --color-muted: oklch(0.52 0.025 280);
    --color-line: oklch(0.91 0.012 280);

    --shadow-card: 0 1px 2px oklch(0.22 0.02 280 / 0.04), 0 10px 30px oklch(0.22 0.02 280 / 0.06);
    --shadow-float: 0 8px 24px oklch(0.22 0.02 280 / 0.12);
    --shadow-brand: 0 10px 24px oklch(0.58 0.24 18 / 0.28);

    --radius-card: 1.5rem;
    --radius-control: 0.875rem;

    --animate-fade-up: fade-up 420ms cubic-bezier(0.22, 1, 0.36, 1) both;
    --animate-soft-pulse: soft-pulse 2.4s ease-in-out infinite;

    @keyframes fade-up {
        from {
            opacity: 0;
            transform: translateY(0.75rem);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @keyframes soft-pulse {
        0%,
        100% {
            opacity: 0.65;
        }
        50% {
            opacity: 1;
        }
    }
}

@layer base {
    html {
        @apply scroll-smooth bg-canvas;
    }

    body {
        @apply min-h-dvh bg-canvas font-sans text-ink antialiased;
    }

    button,
    a,
    input,
    select,
    textarea {
        @apply outline-none;
    }

    button:focus-visible,
    a:focus-visible,
    input:focus-visible,
    select:focus-visible,
    textarea:focus-visible {
        @apply ring-2 ring-brand-500 ring-offset-2 ring-offset-white;
    }

    ::selection {
        @apply bg-brand-200 text-brand-950;
    }
}

@layer components {
    .app-header {
        @apply sticky top-0 z-30 border-b border-line/80 bg-white/90 backdrop-blur-xl;
        padding-top: env(safe-area-inset-top);
    }

    .app-shell {
        @apply mx-auto min-h-dvh w-full max-w-xl bg-white sm:border-x sm:border-line/70;
    }

    .surface-card {
        @apply rounded-card border border-line/80 bg-white shadow-card;
    }

    .form-control {
        @apply w-full rounded-control border border-line bg-white px-4 py-3 text-base text-ink shadow-sm transition placeholder:text-muted/70 hover:border-muted/50 focus:border-brand-500 focus:ring-4 focus:ring-brand-500/10;
    }

    .tap-target {
        @apply inline-flex min-h-11 min-w-11 items-center justify-center;
    }

    .story-ring {
        background: conic-gradient(from 210deg, var(--color-brand-500), var(--color-brand-300), var(--color-brand-600), var(--color-brand-500));
    }

    .content-auto {
        content-visibility: auto;
        contain-intrinsic-size: auto 28rem;
    }

    .safe-bottom {
        padding-bottom: env(safe-area-inset-bottom);
    }

    .safe-top {
        padding-top: env(safe-area-inset-top);
    }

    .scrollbar-subtle {
        scrollbar-color: var(--color-line) transparent;
        scrollbar-width: thin;
    }

    .scrollbar-subtle::-webkit-scrollbar {
        height: 6px;
        width: 6px;
    }

    .scrollbar-subtle::-webkit-scrollbar-thumb {
        border-radius: 999px;
        background: var(--color-line);
    }

    .scrollbar-subtle::-webkit-scrollbar-track {
        background: transparent;
    }
}

@utility no-scrollbar {
    scrollbar-width: none;

    &::-webkit-scrollbar {
        display: none;
    }
}

@media (prefers-reduced-motion: reduce) {
    html {
        scroll-behavior: auto;
    }

    *,
    *::before,
    *::after {
        animation-duration: 0.01ms !important;
        animation-iteration-count: 1 !important;
        scroll-behavior: auto !important;
        transition-duration: 0.01ms !important;
    }
}

